# 🔌 SSH Config — Template do Archimedes Vault
# =========================================================
# Copie este arquivo para ~/.ssh/config em MÁQUINA NOVA:
#   cp guia-ia-local/dotfiles/ssh-config ~/.ssh/config
# Ou rode ./bootstrap.sh que faz isso automaticamente.
#
# ⚠️ ESTE ARQUIVO NÃO CONTÉM SEGREDOS — apenas aliases de host.
# A chave privada (~/.ssh/id_ed25519) NUNCA vai para o repositório.
# Restaure a chave do seu cofre de senhas (Bitwarden) ou gere nova:
#   ssh-keygen -t ed25519 -C "bruno@$(hostname)" -f ~/.ssh/id_ed25519 -N ""
# =========================================================

Host laptop-brn
    HostName 10.0.0.5
    User bruno
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes

Host geekom
    HostName 10.0.0.3
    User brn
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes